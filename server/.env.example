NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fieldtrack?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
STORE_VISIT_RADIUS_METERS=250
LOCATION_MAX_ACCURACY_METERS=100
LOCATION_MAX_SPEED_KMH=160
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Google OAuth (Web client ID from Google Cloud Console — not a secret, but keep out of public docs if you prefer)
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_DOMAINS=

# Optional: fixed passwords for `npm run seed` (otherwise random passwords are printed once)
# SEED_ADMIN_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=

# Frontend (Vite) — set in root .env for local, or in Vercel for production
# VITE_API_URL=/api/v1
# VITE_APP_NAME=FieldTrack
# VITE_GOOGLE_CLIENT_ID=

